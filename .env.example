# Environment Variables for AIESEC Event Scraper
# Copy this file to .env and fill in your values

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_NAME=AIESEC Egypt B2C Event Radar
# GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Email Notification System (SMTP)
# For Gmail, use an App Password (generated at https://myaccount.google.com/apppasswords)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
NOTIFICATION_RECIPIENTS=b2c.egypt@aiesec.net,team.lead@aiesec.net

# Optional AI Multimodal Intelligence (for analyzing flyer images & complex captions)
GEMINI_API_KEY=your_gemini_api_key_here
